{
  "name": "@betterlibs/icons",
  "version": "1.0.0",
  "description": "Iconos SVG como componentes React, accesibles y tree-shakeable.",
  "license": "MIT",
  "author": "YedraN",
  "keywords": [
    "react",
    "icons",
    "svg",
    "tree-shakeable",
    "accessibility"
  ],
  "homepage": "https://github.com/YedraN/betterlibs/tree/main/packages/icons#readme",
