{
  "name": "@betterlibs/tokens",
  "version": "0.0.0",
  "description": "Design tokens de Betterlibs UI: colores, tipografía, espaciado, movimiento y temas como variables CSS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./tokens.css": "./dist/tokens.css",
    "./reset.css": "./dist/reset.css",
    "./base.css": "./dist/base.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YedraN/betterlibs.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "vitest": "5.0.1"
  }
}
