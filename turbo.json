{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "npm_execpath",
    "BETTERLIBS_RELEASE_OFFLINE",
    "BETTERLIBS_LIGHTHOUSE_PORT",
    "BETTERLIBS_LIGHTHOUSE_ROUTES"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
