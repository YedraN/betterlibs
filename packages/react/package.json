{
  "name": "@betterlibs/react",
  "version": "0.0.0",
  "description": "Componentes React accesibles para webs corporativas y profesionales.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YedraN/betterlibs.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@betterlibs/icons": "workspace:^",
    "@radix-ui/react-slot": "1.3.3"
  },
  "peerDependencies": {
    "@betterlibs/tokens": "workspace:^",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@betterlibs/tokens": "workspace:*",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
