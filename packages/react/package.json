{
  "name": "@betterlibs/react",
  "version": "0.0.0",
  "description": "Componentes React accesibles para webs corporativas y profesionales.",
  "license": "MIT",
  "author": "YedraN",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "accessibility",
    "a11y",
    "wcag",
    "corporate",
    "css-modules",
    "rsc"
  ],
  "homepage": "https://github.com/YedraN/betterlibs/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/YedraN/betterlibs/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YedraN/betterlibs.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@betterlibs/icons": "workspace:^",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16"
  },
  "peerDependencies": {
    "@betterlibs/tokens": "workspace:^",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@betterlibs/tokens": "workspace:*",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
